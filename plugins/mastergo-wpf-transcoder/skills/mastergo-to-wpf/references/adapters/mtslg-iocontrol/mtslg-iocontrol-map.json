{
  "_meta": {
    "source": "{source_root}/docs/Windows_setting/MT3.0 界面设计器.xml（目标项目提供的权威文档）",
    "note": [
      "官方标签拼写为 IOContorl（无字母 e），全部控件统一用该标签，由 ControlType 属性区分。",
      "通用属性对所有控件有效：ID / ControlType / IOEnable / IOVisible / Height / Width / Margin / Left / Top / Style。",
      "LangName 几乎所有控件可用（多语言键，CN/EN 成对，须命中键白名单）。",
      "geometryAttrs 由生成器按 DSL bbox 计算直传，禁止从映射输入覆盖；businessAttrs 从映射 JSON 逐节点透传，生成器不校验内容（键校验交给 mtslg-keys.json 白名单）。",
      "容器类控件（nested=true）可包含子 IOContorl；子控件坐标相对父容器左上角。"
    ]
  },
  "commonAttrs": ["ID", "ControlType", "IOEnable", "IOVisible", "Height", "Width", "Margin", "Left", "Top", "Style"],
  "geometryAttrs": ["Left", "Top", "Width", "Height"],
  "businessAttrs": [
    "IOName", "IOCommand", "IOParam", "IOState", "IOStyle", "IOGroup",
    "PageName", "ParameterName", "Value", "Header", "LangName",
    "IsAutoRead", "IsAutoWrite", "IsAutoRefresh", "IsWriteIO", "IsSave",
    "IsShowDialog", "DialogMessage", "IsShowStatus", "IsNeedRedMark",
    "Icon", "IconHeight", "IconWidth", "IconColor", "IconText", "TopLeftContent",
    "StatusBrush", "Foreground", "FontSize", "Orientation",
    "ItemsSourceFile", "DisplayMemberPath", "SelectedValuePath", "Filter",
    "DefaultValue", "MinValue", "MaxValue", "MinRange", "MaxRange",
    "DecimalPlaces", "Keypad", "MaxLength", "DisableRow",
    "DesignPanelID", "IOSetExposure", "IsImagePix", "IsExpendPanel",
    "IsCrossingLineSolid", "IsCrossingLineHorizontal", "IsCrossingLineVertical",
    "IsCrossingMove", "ScalingType", "IsRightMenu", "IsMoveZToFocus", "IsLiveImage",
    "IsCenterRec", "CenterRecWidth", "CenterRecHeight",
    "IsBaseLine", "IsHorizontal", "IsVertical", "IsBaseLineHeight",
    "IsAutoFocus", "IsSwicthMode", "IsLightControl", "IsChangeMode", "YReverse",
    "LeftCameraName", "RightCameraName", "LeftUpVisibility", "RightUpVisibility", "RightDownVisibility",
    "IOAxisName", "AxisType", "AxisMin", "AxisMax", "ImageMin", "ImageMax",
    "RotatePointX", "RotatePointY", "Index"
  ],
